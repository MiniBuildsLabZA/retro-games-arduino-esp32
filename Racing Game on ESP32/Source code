void handleInput() {
  if (digitalRead(BTN_UP) == LOW) {
    carDir = DIR_UP;
  } 
  else if (digitalRead(BTN_DOWN) == LOW) {
    carDir = DIR_DOWN;
  } 
  else if (digitalRead(BTN_LEFT) == LOW) {
    carDir = DIR_LEFT;
  } 
  else if (digitalRead(BTN_RIGHT) == LOW) {
    carDir = DIR_RIGHT;
  }
}


void updateCar() {
  switch (carDir) {
    case DIR_UP:    carY -= 2; break;
    case DIR_DOWN:  carY += 2; break;
    case DIR_LEFT:  carX -= 2; break;
    case DIR_RIGHT: carX += 2; break;
  }


  // Keep inside screen bounds
  if (carX < 0) carX = 0;
  if (carX > SCREEN_WIDTH - 8) carX = SCREEN_WIDTH - 8;
  if (carY < 0) carY = 0;
  if (carY > SCREEN_HEIGHT - 8) carY = SCREEN_HEIGHT - 8;
}



void updateCars() {
    for (int i = 0; i < NUM_CARS; i++) {
      if (carFinished[i]) continue;
        Car &car = cars[i];
        int targetX = roadPath[car.trackIndex][0];
        int targetY = roadPath[car.trackIndex][1];
        if(i<=1){
          targetX = roadPath[car.trackIndex][0];
          targetY = roadPath2[car.trackIndex][1];
        }
        else if(i>1){
          targetX = roadPath[car.trackIndex][0];
          targetY = roadPath2[car.trackIndex][1]; 
        }
        float dx = targetX - car.x;
        float dy = targetY - car.y;
        float dist = sqrt(dx*dx + dy*dy);


        if (dist < car.speed) {
            car.x = targetX;
            car.y = targetY;
            car.trackIndex++;
            /*if (car.trackIndex >= sizeof(roadPath)/sizeof(roadPath[0])) {
                car.trackIndex = 0;
            }*/
        } else {
            car.x += car.speed * (dx / dist);
            car.y += car.speed * (dy / dist);
        }
        if (car.trackIndex == FINISH_LINE_INDEX && !carFinished[i]) {
            carFinished[i] = true;
            carFinishPositions[i] = nextFinishPosition++;
        }
        // Update direction
        if (abs(dx) > abs(dy)) {
            car.dir = (dx > 0) ? RIGHT : LEFT;
        } else {
            car.dir = (dy > 0) ? DOWN : UP;
        }
    }
}


void drawCars() {
    for (int i = 1; i < NUM_CARS; i++) {
        const unsigned char* sprite = nullptr;


        switch (cars[i].dir) {
            case UP:    sprite = epd_bitmap_allArrayUp[i]; break;
            case DOWN:  sprite = epd_bitmap_allArrayDown[i]; break;
            case LEFT:  sprite = epd_bitmap_allArray[i]; break;  // left sprite
            case RIGHT: sprite = epd_bitmap_allArray[i]; break;  // right sprite (add if different)
        }


        if (!carFinished[i]) display.drawBitmap(cars[i].x, cars[i].y, sprite, 7, 5, WHITE);
    }
}
void displayFinishScreen() {
    // Assuming the player is car[0]
    int playerPosition = carFinishPositions[0];


    switch (playerPosition) {
        case 1: display.drawBitmap(0, 0, epd_bitmap_raceOverCover1, 128, 64, WHITE); break;
        case 2: display.drawBitmap(0, 0, epd_bitmap_raceOverCover2, 128, 64, WHITE); break;
        case 3: display.drawBitmap(0, 0, epd_bitmap_raceOverCover3, 128, 64, WHITE); break;
        case 4: display.drawBitmap(0, 0, epd_bitmap_raceOverCover4, 128, 64, WHITE); break;
    }


    display.display();
}


void loop() {
    display.clearDisplay();  // Always clear at start of frame


    if (!gameStarted) {
        // --- Start screen ---
        display.setCursor(0, 0);
        display.drawBitmap(0, 0, epd_bitmap_raceCover, 128, 64, 1);


        // Wait for button press to start
        if (digitalRead(32) == LOW || digitalRead(33) == LOW ||
            digitalRead(25) == LOW || digitalRead(26) == LOW) {
            gameStarted = true;
            delay(200); // small debounce
        }
    } else {
        // --- Game running ---


        // Update AI and player logic
        updateCars();
        handleInput();
        updateCar();


        // Check finish condition
        bool allFinished = true;
        for (int i = 0; i < NUM_CARS; i++) {
            if (!carFinished[i]) {
                allFinished = false;
                break;
            }
        }


        if (allFinished) {
            displayFinishScreen();
        } else {
            // Draw background
            display.drawBitmap(0, 0, epd_bitmap_race, 128, 64, 1);


            // Draw AI cars
            drawCars();


            // Draw player car
            if (carDir == DIR_UP)    display.drawBitmap(carX, carY, epd_bitmap_car1U, 7, 5, WHITE);
            if (carDir == DIR_DOWN)  display.drawBitmap(carX, carY, epd_bitmap_car1D, 7, 5, WHITE);
            if (carDir == DIR_LEFT)  display.drawBitmap(carX, carY, epd_bitmap_car1, 7, 5, WHITE);
            if (carDir == DIR_RIGHT) display.drawBitmap(carX, carY, epd_bitmap_car1, 7, 5, WHITE);
        }
    }


    display.display();
    delay(100); // controls game speed
}

void checkRaceEnd() {


    if (raceFinished) {
    if(joyY>600){
    display.drawBitmap(stopRaceFlagX--,stopRaceFlagY++,epd_bitmap_stop,109,37,SSD1306_BLACK);}
    else{
      display.drawBitmap(stopRaceFlagX,stopRaceFlagY,epd_bitmap_stop,109,37,SSD1306_BLACK);}
      return;
    }
    


    if (destinationP <= 0 || destinationO <= 0) {


        raceFinished = true;


        if (destinationP <= 0 && destinationO <= 0) {


            if (destinationP < destinationO)
                resultState = 1;
            else if (destinationO < destinationP)
                resultState = 2;
            else
                resultState = 3;
        }
        else if (destinationP <= 0) {
            resultState = 1;
        }
        else {
            resultState = 2;
        }
    }
}


void endRace() {


    speed = 0;


    display.fillRect(5, 18, 105, 20, SSD1306_BLACK);
    display.setTextColor(SSD1306_WHITE);
    display.setTextSize(2);


    display.setCursor(10, 20);


    if (resultState == 1) {
        display.print("YOU WIN!");
    }
    else if (resultState == 2) {
        display.print("YOU LOSE!");
    }
    else if (resultState == 3) {
        display.print("DRAW!");
    }


}


void drawCountdown() {


    unsigned long elapsed = millis() - countdownStart;


    int stage = elapsed / 1000; // 0,1,2,3,4


    display.setTextSize(3);
    display.setTextColor(SSD1306_WHITE);


    // Center box
    display.fillRect(34, 18, 60, 28, SSD1306_BLACK);
    display.drawRect(34, 18, 60, 28, SSD1306_WHITE);


    display.setCursor(55, 25);


    if (stage == 0) {
        display.print("3");


        tone(3,300,600);
                delay(700);


    }
    else if (stage == 1) {


      tone(3,200,500);
        display.print("2");
                      delay(600);


    }
    else if (stage == 2) {
      tone(3,100,500);
        display.print("1");
        delay(100);
    }
    else if (stage == 3) {
        display.setTextSize(2);
        display.setCursor(48, 28);
        display.print("GO!");
    }
    else {
        countdownActive = false;
        raceGo = true;
    }
}
void setup() {
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.clearDisplay();


  countdownStart = millis();
}


unsigned long lastCheck = 0;


void loop() {


    if (millis() - lastCheck > 2500) { // Every 5 seconds
        lastCheck = millis();


        if (!nose && random(100) < 40) { // 30% chance
            activateNose();
        }
    }


  display.clearDisplay();
  joyX = analogRead(A0);
  joyY = analogRead(A1);


drawRoad();
drawPlayer();
drawOpp();
drawLogo();
startRace();


checkRaceEnd();


if (raceFinished) {
    endRace();
    display.display();
    return;
}


if (countdownActive) {
    drawCountdown();
    
    display.display();
    return;
}
  display.display();
if (!countdownActive) {
  


    if (joyY > 600) {
        speed = 1.2;
        frame += speed;
    }


    if (joyY < 600) {
        speed = 0;
        oppY -= 3;
    }


}
  

void drawRoad() {

  int horizon = 21;

  for (int y = horizon; y < SCREEN_HEIGHT; y++) {

    float t = (float)(y - horizon) / (SCREEN_HEIGHT - horizon);
    float z = 1.0 - t; // depth (1 far → 0 near)

    int roadHalfWidth = 25 + (t * t * 60);
    int pavementWidth = 4 + (t * 6);

    int curve = 3*sin(frame * 0.02 + t * 3.0) * (20 * t);
    int centerX = 64 + curve;

    int roadLeft = centerX - roadHalfWidth;
    int roadRight = centerX + roadHalfWidth;

    int paveLeft = roadLeft - pavementWidth;
    int paveRight = roadRight + pavementWidth;

    // grass
    bool stripe = ((y / 4 + (int)frame) % 2);
    for (int x = 0; x < SCREEN_WIDTH; x++) {
      display.drawPixel(x, y, stripe ? SSD1306_BLACK : SSD1306_WHITE);
    }

    // pavement
    for (int x = paveLeft; x < roadLeft; x++) {
      if (x >= 0 && x < SCREEN_WIDTH) {
        if ((x + y) % 4 == 0) display.drawPixel(x, y, SSD1306_BLACK);
      }
    }

    for (int x = roadRight; x < paveRight; x++) {
      if (x >= 0 && x < SCREEN_WIDTH) {
        if ((x + y) % 4 == 0) display.drawPixel(x, y, SSD1306_BLACK);
      }
    }

    // road
    for (int x = roadLeft; x <= roadRight; x++) {
      if (x >= 0 && x < SCREEN_WIDTH) {
        display.drawPixel(x, y, SSD1306_WHITE);
      }
    }

    // center dashed line
    if (((y + (int)frame) / 6) % 2 == 0) {
      display.drawPixel(centerX, y, SSD1306_BLACK);
    }


    
}

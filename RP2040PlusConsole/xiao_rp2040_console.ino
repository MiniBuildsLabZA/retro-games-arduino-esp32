        display.drawBitmap(playerX,playerY,epd_bitmap_plaR,24,20,SSD1306_BLACK);
    }
    else{
        display.drawBitmap(playerX,playerY,epd_bitmap_pla,24,20,SSD1306_BLACK);
    }
}


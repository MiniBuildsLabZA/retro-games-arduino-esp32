void randomizeScreenObjects(int screenIndex) {
  int screenBase = screenIndex * 128;

  // Tortoise
  motoBugX = screenBase + random(20, 50);
  totAlive = true;
  totFalling = false;
  totVY = 0;

  // Bug
  meatBugX = screenBase + random(60, 110);
  bugAlive = true;
  bugFalling = false;
  bugVY = 0;
}

void respawnScreenObjects() {
  // Spawn beyond the current right edge of the camera view,
  // so objects are scrolled into view rather than appearing already visible.
  float aheadMin = worldOffset + 128 + 20;   // just past the edge
  float aheadMax = worldOffset + 128 + 100;  // further out, discovered later

  // Tortoise
  motoBugX = random((int)aheadMin, (int)aheadMax);
  totAlive = true;
  totFalling = false;
  totVY = 0;

  // Bug
  meatBugX = random((int)aheadMin, (int)aheadMax);
  bugAlive = true;
  bugFalling = false;
  bugVY = 0;

	//tree1
	tree1X = random((int)aheadMin, (int)aheadMax);
}

void createMeatBug(){
	if(b>2)b=0;

void playSfx(SfxType type)
{
  // Simple passive-buzzer effects for the Expansion Board.
  // tone() is supported by the Seeed XIAO RP2040 Arduino core.
  switch (type) {
    case SFX_JUMP:       tone(BUZZER_PIN, 880, 45); break;
    case SFX_STOMP:      tone(BUZZER_PIN, 600, 40); break;
    case SFX_DAMAGE:     tone(BUZZER_PIN, 220, 120); break;
    case SFX_GAMEOVER:
    case SFX_PAC_DEATH:  tone(BUZZER_PIN, 180, 350); break;
    case SFX_VICTORY:    tone(BUZZER_PIN, 1047, 180); break;
    case SFX_MENU:       tone(BUZZER_PIN, 700, 30); break;
    case SFX_EAT_PELLET: tone(BUZZER_PIN, 1200, 18); break;
    case SFX_PAC_HIT:    tone(BUZZER_PIN, 300, 80); break;
    default: break;
  }
}


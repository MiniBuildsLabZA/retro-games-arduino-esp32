// ---------- helper functions ----------
Direction oppositeDir(Direction d) {
  if (d == RIGHT) return LEFT;
  if (d == LEFT)  return RIGHT;
  if (d == UP)    return DOWN;
  if (d == DOWN)  return UP;
  return NONE;
}

void drawPacBackground(){
  display.drawBitmap(0, 0, epd_bitmap_pac, 128, 64, SSD1306_WHITE);

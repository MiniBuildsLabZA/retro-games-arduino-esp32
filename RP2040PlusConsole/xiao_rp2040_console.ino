void drawPlayer(){

    if(joyX<1000) {
        playerX-=2;
        
        display.drawBitmap(playerX,playerY,epd_bitmap_plaL,24,20,SSD1306_BLACK);
    }

    else if(joyX>3000) {
        playerX+=2;
        
        
        display.drawBitmap(playerX,playerY,epd_bitmap_plaR,24,20,SSD1306_BLACK);
    }
    else if(joyY>3000) {
      speed-=0.5;
      oppY+=1;
      destinationP-=2;
      
      if(playerY<20) {
        display.drawBitmap(playerX,playerY,epd_bitmap_plaR,24,20,SSD1306_BLACK);
        return;
      }
        playerY-=1;
        display.drawBitmap(playerX,playerY,epd_bitmap_plaR,24,20,SSD1306_BLACK);
    }
    else if(joyY<1000) {
      //distanceP+=2;
      destinationO-=2;
      speed+=0.5;
      oppY-=3;
      if(playerY>50) {
        display.drawBitmap(playerX,playerY,epd_bitmap_plaR,24,20,SSD1306_BLACK);

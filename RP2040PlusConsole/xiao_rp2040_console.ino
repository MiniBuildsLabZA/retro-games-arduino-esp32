// --- Health globals ---
int health = 10;
const int MAX_HEALTH = 10;
bool gameOver = false;

// bar geometry
const int HEALTH_BAR_X = 4;
const int HEALTH_BAR_Y = 25;
const int HEALTH_BAR_W = 8;
const int HEALTH_BAR_H = 20;          // total height of the outer rectangle
const int HEALTH_SEGMENT_H = HEALTH_BAR_H / MAX_HEALTH;  // height per stripe
const int HEALTH_SEGMENT_GAP = 1;     // gap between stripes so they read as separate

void drawHealth() {
  // outer frame
  display.drawRect(HEALTH_BAR_X, HEALTH_BAR_Y, HEALTH_BAR_W, HEALTH_BAR_H, SSD1306_WHITE);

  // fill segments from the bottom up, so it drains like a canister
  for (int seg = 0; seg < MAX_HEALTH; seg++) {
    if (seg >= health) continue;   // empty segment: skip, leaves it hollow

    int segY = HEALTH_BAR_Y + HEALTH_BAR_H - (seg + 1) * HEALTH_SEGMENT_H;
    display.fillRect(HEALTH_BAR_X + 1, segY + HEALTH_SEGMENT_GAP,
                      HEALTH_BAR_W - 2, HEALTH_SEGMENT_H - HEALTH_SEGMENT_GAP,
                      SSD1306_WHITE);
  }
}
bool isHurt = false;
bool invincible = false;
unsigned long hurtStartTime = 0;
const unsigned long HURT_DURATION_MS   = 800; // total knockback+flicker time
const unsigned long FLICKER_INTERVAL_MS = 100; // blink rate while invincible

unsigned long lastStompTime = 0;
unsigned long lastFlickTime = 0; // now persists correctly between calls
const unsigned long invincibleDuration = 1000;


bool playerCanBeHit() {
  return !gameOver && !invincible;
}
void loseHealth();
void hitPlayer(float hitSourceScreenX) {
  if (!playerCanBeHit()) return;

  loseHealth();
  isHurt = true;
  invincible = true;
  hurtStartTime = millis();
  vy = jumpForce * 0.5;
  vx = (mario_x < hitSourceScreenX) ? -2.0 : 2.0;
  onGround = false;
}
void updateHurtState() {
  if (invincible && (millis() - hurtStartTime >= invincibleDuration)) {
    invincible = false;
    isHurt = false;
  }
}

bool shouldDrawMega() {
  if (!invincible) return true;
  return (millis() / 100) % 2 == 0;
}
void flickMega(float hitSourceScreenX) {
  if (invincible) return;
  isHurt = true;
  invincible = true;
  hurtStartTime = millis();
  vy = jumpForce * 0.5;
  vx = (mario_x < hitSourceScreenX) ? -2.0 : 2.0;
  onGround = false;
}

void loseHealth() {
  if (gameOver) return;
  health--;
  if (health <= 0) {
    health = 0;
    gameOver = true;
  }
}

void drawGameOver() {
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(40, 28);
  display.print("GAME OVER");
}
void playStompSound() {
  tone(BUZZER_PIN, 600, 40);
  delay(40);
  tone(BUZZER_PIN, 300, 60);
  delay(60);
  noTone(BUZZER_PIN);
}
void drawScore() {
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(55, 5);
  display.print(score);
}


int ninjaDir = 1;          // 1 = right, -1 = left (for jump + bitmap flip)
const float ninjaJumpSpeed = 1.0;
int ninjaJumpTarget = 0;   // where this jump ends

// separate bullet pool so ninja shots don't collide with megaMan's
const int MAX_NINJA_BULLETS = 2;
float ninjaBulletX[MAX_NINJA_BULLETS];
int   ninjaBulletY[MAX_NINJA_BULLETS];
bool  ninjaBulletActive[MAX_NINJA_BULLETS];
int   ninjaBulletDir[MAX_NINJA_BULLETS];

void fireNinjaBullet() {
  for (int b = 0; b < MAX_NINJA_BULLETS; b++) {
    if (!ninjaBulletActive[b]) {
      ninjaBulletActive[b] = true;
      ninjaBulletDir[b] = ninjaDir;
      ninjaBulletX[b] = ninjaX;
      ninjaBulletY[b] = ninjaY + 11;
      break;
    }
  }
}

void updateNinjaBullets() {
  for (int b = 0; b < MAX_NINJA_BULLETS; b++) {
    if (!ninjaBulletActive[b]) continue;
    ninjaBulletX[b] -= bulletSpeed /** ninjaBulletDir[b]*/;
    if (ninjaBulletX[b] < -4 || ninjaBulletX[b] > 128) {
      ninjaBulletActive[b] = false;
      continue;
    }
    display.drawBitmap((int)ninjaBulletX[b] - worldOffset, ninjaBulletY[b], epd_bitmap_bulletOp, 3, 3, SSD1306_WHITE);
  }
}

void updateNinja() {
	if(ninjaAlive){
  unsigned long now = millis();

  switch (ninjaState) {
		case NINJA_HIDDEN:
			if (random(0, 20) < 2) {
				if (random(0, 2)) {
					ninjaState = NINJA_JUMPING;
					ninjaDir = random(0, 2) ? 1 : -1;
					ninjaJumpTarget = (int)ninjaX + ninjaDir * (20 + random(0, 20));
					ninjaJumpTarget = constrain(ninjaJumpTarget, 0, 120);
					ninjaBaseY = ninjaY;        // remember ground level
					ninjaVY = ninjaJumpForce;   // kick upward
				} else {
					ninjaState = NINJA_UNHIDING;
					ninjaFrame = 0;
					ninjaFrameTimer = now;
				}
			}
			break;

    case NINJA_UNHIDING:
      if (now - ninjaFrameTimer >= ninjaFrameDelay) {
        ninjaFrame++;
        ninjaFrameTimer = now;
        if (ninjaFrame >= 3) {
          ninjaState = NINJA_SHOOTING;
          ninjaShootTimer = now;
          fireNinjaBullet();
        }
      }
      break;

    case NINJA_SHOOTING:
      if (now - ninjaShootTimer >= ninjaShootHold) {
        ninjaState = NINJA_HIDING;
        ninjaFrame = 2;
        ninjaFrameTimer = now;
      }
      break;

    case NINJA_HIDING:
      if (now - ninjaFrameTimer >= ninjaFrameDelay) {
        ninjaFrame--;
        ninjaFrameTimer = now;
        if (ninjaFrame < 0) ninjaState = NINJA_HIDDEN;
      }
      break;

		case NINJA_JUMPING:
			ninjaX += ninjaDir * ninjaMoveSpeed;
			ninjaVY += ninjaGravity;
			ninjaY += ninjaVY;

			// clamp horizontal so he doesn't overshoot his target while airborne
			if ((ninjaDir == 1 && ninjaX > ninjaJumpTarget) ||
					(ninjaDir == -1 && ninjaX < ninjaJumpTarget)) {
				ninjaX = ninjaJumpTarget;
			}

			// land when he's back at (or below) ground level, falling
			if (ninjaY >= ninjaBaseY && ninjaVY >= 0) {
				ninjaY = ninjaBaseY;
				ninjaVY = 0;
				ninjaState = NINJA_HIDDEN;
			}
			break;
  }

  updateNinjaBullets();
	}
}


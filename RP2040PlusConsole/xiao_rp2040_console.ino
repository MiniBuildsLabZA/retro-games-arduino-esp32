// --- Player hitbox (approximate — matches your ladder-trigger box) ---
const int PLAYER_W = 18;
const int PLAYER_H = 21;

// --- Player invulnerability after taking a hit ---
unsigned long lastHitTime = 0;
const unsigned long hitCooldown = 1000; // ms of i-frames after damage

// --- Generic AABB test (all args must already be in the SAME space) ---
bool aabbCollide(float ax, float ay, int aw, int ah,
                  float bx, float by, int bw, int bh) {
  return ax < bx + bw && ax + aw > bx &&
         ay < by + bh && ay + ah > by;
}

/*bool playerCanBeHit() {
  return !gameOver && (millis() - lastHitTime >= hitCooldown);
}*/

void damagePlayer() {
  if (!playerCanBeHit()) return;
  loseHealth();
  lastHitTime = millis();
}

// ---------------------------------------------------------------------
// 1. JACK — stomp to kill, side/bottom touch damages player
// ---------------------------------------------------------------------
void checkJackCollision() {
  if (!jackAlive) return;

  bool compressed = !jackAirborne;
  int jw = compressed ? JACK_W_COMPRESSED : JACK_W_EXTENDED;
  int jh = compressed ? JACK_H_COMPRESSED : JACK_H_EXTENDED;
  int jDrawY = (int)jackY + (JACK_H_EXTENDED - jh);
  float jScreenX = jackX - worldOffset;

  if (!aabbCollide(mario_x, mario_y, PLAYER_W, PLAYER_H,
                    jScreenX, jDrawY, jw, jh)) {
    return;
  }

  float prevBottom = (mario_y + PLAYER_H) - vy;
  bool stomping = (vy > 0.5) && (prevBottom <= jDrawY + 6);

  if (stomping) {
    jackAlive = false;
    score += 100;
    vy = jumpForce * 0.6; // stomp bounce (separate from hurt knockback)
  } else {
    hitPlayer(jScreenX);
  }
}


//dino_movement_and_physics
float vx = 0;
float vy = 0;

const float gravity = 0.4;
const float moveSpeedD = 0.5;
const float jumpForce = -4.5;

bool onGround = true;
int cdino=0;

void moveDino(){

  int joyX = analogRead(JOYSTICK_X_PIN);
  int joyY = analogRead(JOYSTICK_Y_PIN);

    if (gameEnded) {
        display.drawBitmap(Dino_x, Dino_y, epd_bitmap_dino[0], 20, 19, SSD1306_WHITE);
        display.drawBitmap(30, 26, epd_bitmap_Game_over, 63, 8, SSD1306_WHITE);
        return;
    }

  // Left/right movement
  if (joyX < 1000)
    vx -= moveSpeedD;

  else if (joyX > 3000)
    vx += moveSpeedD;
  else vx=0;
  // Friction
  vx *= 0.9;

  // Jump
  if (joyY > 3000 && onGround) {
    vy = jumpForce;
    onGround =false;
  }

  // Gravity
  vy += gravity;

  // Update position
 Dino_x += vx;
  Dino_y += vy;

  // Ground collisions

if (Dino_y > 39) {
   Dino_y=39;
    vy = 0;
    onGround = true;
}

// Dino hitbox (slightly inset from the 20x19 bitmap)
float dx1 = Dino_x + 5;
float dx2 = Dino_x + 15;
float dy1 = Dino_y + 3;
float dy2 = Dino_y + 15;

// Obstacle 1 (10x21)
if (dx2 > ob1x &&
    dx1 < ob1x + 10 &&
    dy2 > ob1y &&
    dy1 < ob1y + 21)
{ gameEnded = true; }

// Obstacle 2 (6x11)
if (dx2 > ob2x &&
    dx1 < ob2x + 6 &&
    dy2 > ob2y &&
    dy1 < ob2y + 11)
{ gameEnded = true; }

// Obstacle 3 (6x11)
if (dx2 > ob3x &&
    dx1 < ob3x + 6 &&
    dy2 > ob3y &&
    dy1 < ob3y + 11)
{ gameEnded = true; }

// Car 1 (29x17)
if (dx2 > car1_x &&
    dx1 < car1_x + 29 &&
    dy2 > car1_y &&
    dy1 < car1_y + 17)
{ gameEnded = true; }



  if (Dino_x < 0) {
   Dino_x = 0;
    vx = 0;
  }

  if (Dino_x > 120) {
   Dino_x = 120;
    vx = 0;
  }
 
  if(cdino>2) cdino=0;
  display.drawBitmap(Dino_x, Dino_y, epd_bitmap_dino[cdino], 20, 19, SSD1306_WHITE);
  

  cdino++;
}

void updateScore(float &scoreTemp){
    display.setCursor(70, 3);
    display.setTextColor(SSD1306_WHITE);
    display.print("Score: ");
    display.print((int)scoreTemp);

}


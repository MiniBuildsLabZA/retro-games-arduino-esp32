// --- lane offset control ---
int laneOffset = 0;      // 0 = middle lane, negative = upper lane, positive = lower
const int laneStep = 2;  // how far apart lanes ar

void handleInput() {
  int joyX = analogRead(JOYSTICK_X_PIN);
  int joyY = analogRead(JOYSTICK_Y_PIN);
  if (joyY>3000) {
    carDir = DIR_UP;
  } 
  else if (joyY<1000) {
    carDir = DIR_DOWN;
  } 
  else if (joyX<1000) {
    carDir = DIR_LEFT;
  } 
  else if (joyX>3000) {
    carDir = DIR_RIGHT;
  }
}
// Draw a small triangle marker above the player's car
void drawPlayerMarker(int x, int y) {
    int cx = x + 3;      // horizontal center of the 7px-wide car
    int topY = y - 5;    // a few pixels above the car
    // Downward-pointing triangle (like an arrow saying "you are here")
    display.fillTriangle(
        cx - 2, topY,      // top-left
        cx + 2, topY,      // top-right
        cx,     topY + 4,  // bottom point
        WHITE
    );
}
void updateCar() {
  switch (carDir) {
    case DIR_UP:    carY -= 2; break;
    case DIR_DOWN:  carY += 2; break;
    case DIR_LEFT:  carX -= 2; break;
    case DIR_RIGHT: carX += 2; break;
  }

  // Keep inside screen bounds
  if (carX < 0) carX = 0;
  if (carX > SCREEN_WIDTH - 8) carX = SCREEN_WIDTH - 8;
  if (carY < 0) carY = 0;
  if (carY > SCREEN_HEIGHT - 8) carY = SCREEN_HEIGHT - 8;
}


void updateCars() {
    for (int i = 0; i < NUM_CARS; i++) {
      if (carFinished[i]) continue;
        Car &car = cars[i];
        int targetX = roadPath[car.trackIndex][0];
        int targetY = roadPath[car.trackIndex][1];
        if(i<=1){
          targetX = roadPath[car.trackIndex][0];
          targetY = roadPath2[car.trackIndex][1];
        }
        else if(i>1){
          targetX = roadPath[car.trackIndex][0];
          targetY = roadPath2[car.trackIndex][1]; 
        }
        float dx = targetX - car.x;
        float dy = targetY - car.y;
        float dist = sqrt(dx*dx + dy*dy);

        if (dist < car.speed) {
            car.x = targetX;
            car.y = targetY;
            car.trackIndex++;

        } else {
            car.x += car.speed * (dx / dist);
            car.y += car.speed * (dy / dist);
        }
        if (car.trackIndex == FINISH_LINE_INDEX && !carFinished[i]) {
            carFinished[i] = true;
            carFinishPositions[i] = nextFinishPosition++;
        }
        // Update direction
        if (abs(dx) > abs(dy)) {
            car.dir = (dx > 0) ? RIGHT : LEFT;
        } else {
            car.dir = (dy > 0) ? DOWN : UP;
        }
    }
}

void drawCars() {
    for (int i = 1; i < NUM_CARS; i++) {
        const unsigned char* sprite = nullptr;

        switch (cars[i].dir) {
            case UP:    sprite = cars_arra_Up[i]; break;
            case DOWN:  sprite = cars_arra_Down[i]; break;
            case LEFT:  sprite = cars_arra_[i]; break;  // left sprite
            case RIGHT: sprite = cars_arra_[i]; break;  // right sprite (add if different)
        }

        if (!carFinished[i]) display.drawBitmap(cars[i].x, cars[i].y, sprite, 7, 5, WHITE);
    }
}
void displayFinishScreen() {
    // Assuming the player is car[0]
    int playerPosition = carFinishPositions[0];

    switch (playerPosition) {
        case 1: display.drawBitmap(0, 0, epd_bitmap_raceOverCover1, 128, 64, WHITE); break;
        case 2: display.drawBitmap(0, 0, epd_bitmap_raceOverCover2, 128, 64, WHITE); break;
        case 3: display.drawBitmap(0, 0, epd_bitmap_raceOverCover3, 128, 64, WHITE); break;
        case 4: display.drawBitmap(0, 0, epd_bitmap_raceOverCover4, 128, 64, WHITE); break;
    }

    display.display();
}

  mario_x = START_MARIO_X;
  mario_y = START_MARIO_Y;
  vx3 = 0;
  vy2 = 0;
  onGround2 = true;
  killed = false;
  gameWonM = false;

  worldOffset = START_WORLD_OFFSET;
  currentScreen = getCurrentScreen();

  // Put enemies/items back to their starting layout for screen 0
  randomizeScreenObjects(0);
}
void respawnScreenObjects() {
  // Spawn beyond the current right edge of the camera view,
  // so objects are scrolled into view rather than appearing already visible.
  float aheadMin = worldOffset + 128 + 20;   // just past the edge
  float aheadMax = worldOffset + 128 + 100;  // further out, discovered later

  // Tortoise
  totX = random((int)aheadMin, (int)aheadMax);
  totAlive = true;
  totFalling = false;
  totVY = 0;

  // Bug
  bugX = random((int)aheadMin, (int)aheadMax);
  bugAlive = true;
  bugFalling = false;
  bugVY = 0;

  // Flower
  flowerX = random((int)aheadMin, (int)aheadMax);
  z = random(0, 5);
  flowerDirection = 0.5;

  // Bricks / power brick
  brickX = random((int)aheadMin, (int)aheadMax);
  powerX = random((int)aheadMin, (int)aheadMax);
  powerBrickBroken = false;
  brickFalling = false;
  fallingBrickY = powerY;
}

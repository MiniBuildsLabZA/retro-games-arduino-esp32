// Usage example:
int pathLength = sizeof(roadPath) / sizeof(roadPath[0]);
// or for racing line: sizeof(racingLine) / sizeof(racingLine[0]);

//enum Direction { LEFT, RIGHT, UP, DOWN };

struct Car {
    float x;
    float y;
    int trackIndex;
    float speed;
    Direction dir;
};

#define BTN_UP 32
#define BTN_DOWN 33
#define BTN_LEFT 25
#define BTN_RIGHT 26
// Direction states
#define DIR_UP    0
#define DIR_DOWN  1
#define DIR_LEFT  2
#define DIR_RIGHT 3

int carX = 106;   // starting position
int carY = 31;
int carDir = DIR_LEFT; // default direction
#define NUM_CARS 4
#define FINISH_LINE_INDEX (pathLength - 1) // assuming the last point is the finish line

bool carFinished[NUM_CARS] = {false}; // track if each car finished
int carFinishPositions[NUM_CARS]; // track finishing order
int nextFinishPosition = 1; // to assign positions as cars finish


Car cars[NUM_CARS] = {
    {roadPath[0][0], roadPath[0][1], 0, 2.5},
    {roadPath[0][0], roadPath2[0][1], 0, 2.0},
    {roadPath2[0][0], roadPath[0][1], 0, 2.5},

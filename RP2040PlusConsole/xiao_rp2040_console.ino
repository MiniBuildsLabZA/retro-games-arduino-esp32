//ball_movement_and_physics
float vx1 = 0;
float vy2 = 0;

const float gravity1 = 0.3;
const float moveSpeed1 = 0.3;
const float jumpForce1 = -3.0;

bool onGround1 = true;
unsigned long swPressStart = 0;
bool swHeld = false;
const unsigned long LONG_PRESS_MS = 800; // hold time to trigger menu return

bool checkLongPressReturnToMenu() {
  bool pressed = (digitalRead(JOYSTICK_SW_PIN) == LOW);

  if (pressed) {
    if (!swHeld) {
      swHeld = true;
      swPressStart = millis();
    }
    else if (millis() - swPressStart >= LONG_PRESS_MS) {
      // Wait for release so we don't retrigger and don't leak
      // the release into showMenu()'s button check next frame.
      while (digitalRead(JOYSTICK_SW_PIN) == LOW) ;
      swHeld = false;
      return true;
    }
  } else {
    swHeld = false;
  }
  return false;
}
void moveBall(){

  int joyX = analogRead(JOYSTICK_X_PIN);
  int joyY = analogRead(JOYSTICK_Y_PIN);

  // Left/right movement
  if (joyX < 1000)
    vx1 -= moveSpeed1;

  else if (joyX > 3000)
    vx1 += moveSpeed1;
  else vx1=0;
  // Friction
  vx1 *= 0.9;

  // Jump
  if (joyY > 3000 && onGround1) {
    vy2 = jumpForce1;
    onGround1 =false;
  }

  // gravity1
  vy2 += gravity1;

  // Update position
  ball_x += vx1;
  ball_y += vy2;

  // Ground collisions

if (ball_y > 55) {
   delay(500);
   ball_x=6;
   ball_y=32;
    vy2 = 0;
    onGround1 = true;
    lives--;
}
if (ball_x >= -1 && ball_x < 17 && vy2 >= 0) {
    if (ball_y >= 33) {
        ball_y = 33;
        vy2 = 0;
        onGround1 = true;
    }
}
if (ball_x >= 12 && ball_x <= 21 && vy2 >= 0) {
    if (ball_y >= 27) {
        ball_y = 27;
        vy2 = 0;
        onGround1 = true;
    }
}
if (ball_x >= obstacle1_x && ball_x <= obstacle1_x + 16 && vy2 >= 0) {
    if (ball_y >= 38) {
        ball_y = 38;
        vy2 = 0;
        ball_x +=obstacle1_direction;
        if(ball_x >= obstacle1_x+6 && ball_x <= obstacle1_x + 10 && vy2 >= 0){
            lives--;
            delay(500);
            ball_x=6;
            ball_y=32;
        }

        onGround1 = true;
    }
}
if (ball_x >= obstacle2_x && ball_x <= obstacle2_x + 16 && vy2 >= 0) {
    if (ball_y >= 38) {
        ball_y = 38;
        vy2 = 0;
        ball_x +=obstacle2_direction;
        if(ball_x >= obstacle2_x+4 && ball_x <= obstacle2_x + 4 && vy2 >= 0){
            lives--;
            delay(500);
            ball_x=6;
            ball_y=32;
        }
        onGround1 = true;
    }
}
if (ball_x >= 74 && ball_x <= 86 && vy2 >= 0) {
    if (ball_y >= 33) {
        ball_y = 33;
        vy2 = 0;
        onGround1 = true;
    }
}
if (ball_x > 86 && ball_x <= 99 && vy2 >= 0) {
    if (ball_y >= 37) {
        ball_y = 37;
        vy2 = 0;
        onGround1 = true;
    }
}

if (ball_x >= obstacle3_x-5 && ball_x <= obstacle3_x + 5 && vy2 >= 0) {
    if (ball_y >= obstacle3_y-7) {
        ball_y = obstacle3_y-7;
        vy2 = 0;
        ball_y +=obstacle3_direction;
        onGround1 = true;
    }
}
if (ball_x > 108 && ball_x <= 129 && vy2 >= 0) {
    if (ball_y >= 37) {
        ball_y = 37;
        vy2 = 0;
    if(ball_x > 120 && ball_x <= 129 && vy2 >= 0){
        youWin();
        
    }

        onGround1 = true;
    }
}

  if (ball_x < 0) {
    ball_x = 0;
    vx1 = 0;
  }

  if (ball_x > 120) {
    ball_x = 120;
    vx1 = 0;
  }
  
  display.drawBitmap(ball_x, ball_y, epd_bitmap_ball, 7, 7, SSD1306_WHITE);
}

void drawLives(int livesTemp){
    int pos[3] = {95,106,117};
if(livesTemp==0) gameOver(); //game over
else{
  for(int i = 0; i<livesTemp; i++){
    display.drawBitmap(pos[i], 3, livesArr[i], 7, 6, SSD1306_WHITE);
  }
}

}

void runFrame(){
  if (gameOver) {
    drawGameOver();
  } else {
		display.clearDisplay();
    drawBackground();
    updateScene();
		tryRespawnNinja();
    updateNinja();
    createNinja();
		tryRespawnJack();
    updateJack();
    createJack();
		tryRespawnBurger();
    updateBurger();
    createBurgerShoot();
		drawScore();
    if (sceneState != 1) moveMegaMan();
    drawHealth();
		checkPlayerBulletsVsEnemies();
    checkJackCollision();
    checkNinjaBulletsVsPlayer();
    checkBurgerBulletsVsPlayer();
		updateHurtState();
  }
  display.display();
}

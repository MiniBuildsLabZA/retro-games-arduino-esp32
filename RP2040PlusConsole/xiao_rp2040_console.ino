void randomizeScreenObjects(int screenIndex) {
  int screenBase = screenIndex * 128;

  // Tortoise
  totX = screenBase + random(20, 50);
  totAlive = true;
  totFalling = false;
  totVY = 0;

  // Bug
  bugX = screenBase + random(60, 110);
  bugAlive = true;
  bugFalling = false;
  bugVY = 0;

  // Flower
  flowerX = screenBase + random(60, 110);
  z = random(0, 5);          // random starting sprite frame
  flowerDirection = 0.5;

  // Bricks / power brick
  brickX = screenBase + random(10, 100);
  powerX = screenBase + random(10, 100);
  powerBrickBroken = false;
  brickFalling = false;
  fallingBrickY = powerY;
}

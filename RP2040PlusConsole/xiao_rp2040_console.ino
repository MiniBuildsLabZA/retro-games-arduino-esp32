bool isMenu = true;
const char *items[] = {"Mario","Sonic","Pac-Man","Mega Man","Dino Run","Ultimate Race","Bounce","Race 2","Flappy"};
#define MENU_ITEMS 9

#define ITEMS_VISIBLE 3 // how many items fit on screen
#define ITEM_HEIGHT 16
#define MENU_START_Y 14

// Returns selected index 0..MENU_ITEMS-1
int showMenu(const char *title, const char *items[])
{
    int selected = 0;
    int offset = 0; // first item currently shown
    int lastY = analogRead(JOYSTICK_Y_PIN);

    while (true)
    {
        // Update scroll offset so selected item is always visible
        if (selected < offset)
            offset = selected;
        if (selected >= offset + ITEMS_VISIBLE)
            offset = selected - ITEMS_VISIBLE + 1;

        // Draw menu
        display.clearDisplay();
        display.drawBitmap(0, 0, epd_bitmap_lablogo, 21, 17, SSD1306_WHITE);

        display.setTextSize(1);
        display.setTextColor(SSD1306_WHITE);

        display.setCursor(30, 0);
        display.println(title);
        display.drawLine(30, 10, 127, 10, SSD1306_WHITE);

        // Draw only visible items
        for (int i = 0; i < ITEMS_VISIBLE; i++)
        {
            int itemIndex = i + offset;
            if (itemIndex >= MENU_ITEMS) break;

            display.setCursor(30, MENU_START_Y + i * ITEM_HEIGHT);

            if (itemIndex == selected)
                display.print("> ");
            else
                display.print(" ");

            display.println(items[itemIndex]);
        }

        // Optional: draw scroll indicators
        if (offset > 0)
            display.drawTriangle(125, MENU_START_Y-2, 121, MENU_START_Y+2, 129, MENU_START_Y+2, SSD1306_WHITE); // up arrow
        if (offset + ITEMS_VISIBLE < MENU_ITEMS)
            display.drawTriangle(125, 63, 121, 59, 129, 59, SSD1306_WHITE); // down arrow

        display.display();

        // Read joystick
        int y = analogRead(JOYSTICK_Y_PIN);

        // Scroll down
        if (y < 1200 && lastY >= 1200)
        {
            selected++;
            if (selected >= MENU_ITEMS)
                selected = 0;
            delay(180);
        }

        // Scroll up
        if (y > 3000 && lastY <= 3000)
        {
            selected--;
            if (selected < 0)
                selected = MENU_ITEMS - 1;
            delay(180);
        }

        lastY = y;

        // Button pressed?
        if (digitalRead(JOYSTICK_SW_PIN) == LOW)
        {
            delay(200);
            while (digitalRead(JOYSTICK_SW_PIN) == LOW) ; // wait for release
            return selected;
        }

        delay(20);
    }
}


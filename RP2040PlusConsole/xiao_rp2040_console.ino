const uint8_t* sprite = epd_bitmap_Pac[2];
if (currentDir == LEFT)  {
  sprite = epd_bitmap_allArray_L[(int)L];
}
if (currentDir == DOWN)  {
  sprite = epd_bitmap_allArray_D[(int)D];
}
if (currentDir == UP)    {
  sprite = epd_bitmap_allArray_U[(int)U];
}
if (currentDir == RIGHT) {
  sprite = epd_bitmap_allArray_R[(int)R];
}

  //display.drawBitmap(pacX, pacY, sprite, 5, 5, SSD1306_WHITE);
  if (!pacInvincible || pacBlinkVisible) {
    display.drawBitmap(pacX, pacY, sprite, 5, 5, SSD1306_WHITE);
  }
}

void moveGhostRandom(Ghost &g) {
  bool atNode = (g.x == g.toNode.x && g.y == g.toNode.y);

  if (atNode) {
    Direction all[4] = {UP, DOWN, LEFT, RIGHT};
    Direction opp = oppositeDir(g.currentDir);

    Direction options[4];
    int count = 0;
    Point next;

    for (int i = 0; i < 4; i++) {
      if (all[i] == opp) continue;
      if (findNeighbor(g.toNode, all[i], next)) {
        options[count++] = all[i];
      }
    }

    if (count == 0 && opp != NONE && findNeighbor(g.toNode, opp, next)) {
      options[count++] = opp;
    }

    if (count > 0) {
      Direction chosen = options[random(count)];
      findNeighbor(g.toNode, chosen, next);
      g.fromNode = g.toNode;
      g.toNode   = next;
      g.currentDir = chosen;
    }
  }

  if (g.currentDir == RIGHT && g.x < g.toNode.x) g.x+=0.5;
  if (g.currentDir == LEFT  && g.x > g.toNode.x) g.x-=0.5;
  if (g.currentDir == DOWN  && g.y < g.toNode.y) g.y+=0.5;
  if (g.currentDir == UP    && g.y > g.toNode.y) g.y-=0.5;
}

void drawScore() {
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 56);
  display.print("S:");
  display.print(score);
}

bool checkGhostCollision() {
  for (int i = 0; i < 4; i++) {
    if (!pacInvincible &&
        abs(pacX - ghosts[i].x) <= COLLISION_RADIUS &&
        abs(pacY - ghosts[i].y) <= COLLISION_RADIUS) {
        pacInvincible = true;
        hitTimer = millis();
        pacBlinkTimer = millis();
        pacBlinkVisible = false;  
      return true;
    }
  }
  return false;
}

void respawnPac() {
  pacX = PAC_START_X;
  pacY = PAC_START_Y;
  fromNode = {(int)PAC_START_X, (int)PAC_START_Y};
  toNode   = {(int)PAC_START_X, (int)PAC_START_Y};
  currentDir = NONE;
  desiredDir = NONE;
}

void moveGhost(){
  for (int i = 0; i < 4; i++) {
    moveGhostRandom(ghosts[i]);
    display.drawBitmap(ghosts[i].x, ghosts[i].y, epd_bitmap_pacaOppR, 6, 5, SSD1306_WHITE);
  }

  if (checkGhostCollision()) {
    respawnPac();
    pacLives--;
    playSfx(SFX_PAC_HIT);
    //startSound(SOUND_DEATH);
  }
}

void drawPacLives(int livesTemp){
    int pos[3] = {0,8,16};
    if(livesTemp<=0)
    {
        if (!pacEnded) {           // only true the very first frame this happens
            playSfx(SFX_PAC_DEATH);
        }
        pacEnded = true;
        display.setCursor(10, 20);
        display.setTextSize(2);
        display.setTextColor(SSD1306_WHITE);
        display.print("GAME OVER");
    }
    else{
        for(int i = 0; i<livesTemp; i++){
            display.drawBitmap(pos[i], 40, pacArr[i], 5, 5, SSD1306_WHITE);
        }
    }
}


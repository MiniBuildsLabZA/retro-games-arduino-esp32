void movePac(){
  joyX = analogRead(JOYSTICK_X_PIN);
  joyY = analogRead(JOYSTICK_Y_PIN);
  // ---- Invincibility flash after a ghost hit ----
  if (pacInvincible) {
    if (millis() - hitTimer >= INVINCIBLE_DURATION_MS) {
      pacInvincible = false;
      pacBlinkVisible = true;   // make sure Pac ends up visible once flash ends
    } else if (millis() - pacBlinkTimer >= PAC_BLINK_INTERVAL_MS) {
      pacBlinkTimer = millis();
      pacBlinkVisible = !pacBlinkVisible;
    }
  }

  if (joyX > 3000)      desiredDir = RIGHT;
  else if (joyX < 1000) desiredDir = LEFT;
  else if (joyY > 3000) desiredDir = UP;
  else if (joyY < 1000) desiredDir = DOWN;
  // if joystick is centered, desiredDir keeps its last value (buffered turn)

  bool atNode = (pacX == toNode.x && pacY == toNode.y);

  if (atNode) {
    Point next;
    if (desiredDir != NONE && findNeighbor(toNode, desiredDir, next)) {
      fromNode = toNode;
      toNode   = next;
      currentDir = desiredDir;
    }
    else if (currentDir != NONE && findNeighbor(toNode, currentDir, next)) {
      fromNode = toNode;
      toNode   = next;
    }
    else {
      currentDir = NONE; // dead end / no valid move
    }
  }
  else {
    // Mid-edge: allow instant reversal (classic Pac-Man feel)
    Direction opp = (currentDir==RIGHT)?LEFT : (currentDir==LEFT)?RIGHT :
                    (currentDir==UP)?DOWN   : (currentDir==DOWN)?UP : NONE;
    if (desiredDir == opp) {
      Point tmp = fromNode;
      fromNode = toNode;
      toNode = tmp;
      currentDir = desiredDir;
    }
  }

  // Step one pixel per frame toward toNode, constrained to the graph edge
  if (currentDir == RIGHT && pacX < toNode.x) pacX+=0.5;
  if (currentDir == LEFT  && pacX > toNode.x) pacX-=0.5;
  if (currentDir == DOWN  && pacY < toNode.y) pacY+=0.5;
  if (currentDir == UP    && pacY > toNode.y) pacY-=0.5;

  for (int i = 0; i < pelletCount; i++) {
    if (!pellets[i].eaten &&
        abs((int)pacX - pellets[i].x) <= 2 &&
        abs((int)pacY - pellets[i].y) <= 2) {
        playSfx(SFX_EAT_PELLET);
        pellets[i].eaten = true;
        score++;
    }
  }
 D+=pacD;
 U+=pacU;
 L+=pacL;
 R+=pacR;
  if(U>2)pacU=-0.5;
  if(L>2)pacL=-0.5;
  if(R>2)pacR=-0.5;
  if(D>2)pacD=-0.5;
